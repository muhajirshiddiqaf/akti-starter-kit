{
  "name": "express-api-starter",
  "type": "module",
  "version": "2.0.0",
  "description": "A basic starter for an express.js API",
  "author": "CJ R. <cj@null.computer> (https://w3cj.now.sh)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/w3cj/express-api-starter.git"
  },
  "keywords": [],
  "main": "src/index.js",
  "scripts": {
    "start": "concurrently -n be,fe -c blue,green \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "nodemon",
    "start:frontend": "cd frontend && npm start",
    "dev": "node --watch --env-file=.env src/index.js",
    "build:frontend": "cd frontend && npm run build",
    "lint": "eslint --fix src",
    "test": "vitest run",
    "install-all": "npm install && cd frontend && npm install"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "concurrently": "^9.2.1",
    "eslint-plugin-format": "^1.0.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "vitest": "^4.0.6"
  }
}
